tmp
config/data

# Entornos virtuales
venv/
.venv/
env/

# Bytecode y cachés de Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Variables de entorno y secretos — NUNCA subir API keys al repo
.env
!.env.example
*.key
credentials/

# Datos generados en runtime — no son código, se regeneran
chroma_data/

# Vault de Obsidian: contiene el conocimiento del negocio (precios,
# datos de clientes en notas, etc.). Normalmente NO debería ir en el
# mismo repo público del código, o al menos no en uno público.
# Si quieres versionarlo, hazlo en un repo privado aparte o quita
# esta línea conscientemente.
vault_negocio/

# Assets estáticos reales de un negocio concreto (logo, fuentes .woff2,
# fotos) referenciados desde config/data/*.yaml (logo_url, fuente_*_url,
# etc. — issue #96). Mismo motivo que config/data y vault_negocio/: no
# son del repo público del esqueleto. Los assets de la demo (logo.svg,
# favicon...) siguen en la raíz de frontend/public/, sí versionados.
frontend/public/negocio/

# Editores
.vscode/
.idea/
*.swp

# Sistema
.DS_Store
Thumbs.db

# Logs
*.log
