---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { stat } from 'node:fs/promises';
import path from 'node:path';
import { extraerTitulo } from '../../lib/resumen';

interface Props {
  nota: CollectionEntry<'vault'>;
}

const { nota } = Astro.props;
const titulo = extraerTitulo(nota.body ?? '', nota.id);
const resumen = nota.data.resumen;
const { Content } = await render(nota);
const idDialogo = `contenido-${nota.id.replace(/[^a-zA-Z0-9_-]/g, '-')}`;

// nota.filePath es relativo a la raíz del proyecto Astro (frontend/), no
// al vault; de ahí el path.resolve contra el cwd del proceso de build.
const fechaModificacion = nota.filePath
  ? (await stat(path.resolve(process.cwd(), nota.filePath))).mtime
  : null;
const fechaModificacionTexto = fechaModificacion
  ? new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long', year: 'numeric' }).format(
      fechaModificacion,
    )
  : null;
---

<article
  data-fuente={`${nota.id}.md`}
  class="rounded-2xl border border-(--color-borde) bg-(--color-superficie) transition-colors duration-300 hover:border-(--color-acento) hover:bg-(--color-acento-suave) [&.destacado]:border-(--color-acento) [&.destacado]:bg-(--color-acento-suave)"
>
  {
    /*
      Por debajo de `lg` (móvil/tableta) la tarjeta navega directo a la
      página de la nota — un <a> real, no JS: funciona con clic derecho/
      "abrir en pestaña nueva" y es más amigable para rastreadores. A
      partir de `lg` (escritorio) se mantiene el popup de siempre. Los
      dos elementos existen en el DOM a la vez, alternados por CSS —
      igual que ya no hay JS que decida el breakpoint en ningún otro
      sitio de esta rejilla.
    */
  }
  <a
    href={`/contenido/${nota.id}/`}
    class="block w-full p-(--spacing-fluid-s) text-left lg:hidden"
  >
    <p class="text-xs font-medium uppercase tracking-wide text-(--color-acento)">
      {nota.data.categoria}
    </p>
    <h3 class="mt-(--spacing-fluid-3xs) text-lg font-semibold text-(--color-texto)">{titulo}</h3>
    {resumen && <p class="mt-(--spacing-fluid-2xs) text-sm text-(--color-texto-suave)">{resumen}</p>}
  </a>
  <button
    type="button"
    data-abre-dialogo={idDialogo}
    class="hidden w-full cursor-pointer appearance-none border-0 bg-transparent p-(--spacing-fluid-s) text-left lg:block"
  >
    <p class="text-xs font-medium uppercase tracking-wide text-(--color-acento)">
      {nota.data.categoria}
    </p>
    <h3 class="mt-(--spacing-fluid-3xs) text-lg font-semibold text-(--color-texto)">{titulo}</h3>
    {resumen && <p class="mt-(--spacing-fluid-2xs) text-sm text-(--color-texto-suave)">{resumen}</p>}
  </button>
</article>

<dialog
  id={idDialogo}
  class="m-auto h-[90vh] w-[90vw] max-w-4xl rounded-2xl border border-(--color-borde) bg-(--color-superficie) p-0 backdrop:bg-black/50"
>
  <div class="flex h-full flex-col">
    <div class="flex items-center justify-between border-b border-(--color-borde) p-(--spacing-fluid-s)">
      <p class="text-xs font-medium uppercase tracking-wide text-(--color-acento)">
        {nota.data.categoria}
      </p>
      <button
        type="button"
        data-cierra-dialogo
        aria-label="Cerrar"
        class="rounded-full p-(--spacing-fluid-3xs) text-(--color-texto-suave) transition-colors hover:bg-(--color-acento-suave) hover:text-(--color-acento)"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M18 6 6 18M6 6l12 12" />
        </svg>
      </button>
    </div>
    <div class="flex-1 overflow-y-auto p-(--spacing-fluid-s)">
      <div class="contenido-nota mx-auto max-w-3xl text-(--color-texto)">
        <Content />
      </div>
    </div>
    <div class="flex items-center justify-between border-t border-(--color-borde) p-(--spacing-fluid-s) text-xs text-(--color-texto-suave)">
      <a href={`/contenido/${nota.id}/`} class="text-(--color-acento) hover:underline">
        Ver página completa
      </a>
      {fechaModificacionTexto && <span>Última actualización: {fechaModificacionTexto}</span>}
    </div>
  </div>
</dialog>
