---
import { getCollection } from 'astro:content';
import TarjetaContenido from './TarjetaContenido.astro';

const notas = (await getCollection('vault', ({ data }) => data.publicar_web === true)).sort(
  (a, b) => (a.data.orden ?? Infinity) - (b.data.orden ?? Infinity),
);
---

<section id="contenido-publico" class="mx-auto max-w-3xl px-(--spacing-fluid-s) py-(--spacing-fluid-l) md:max-w-none md:px-(--spacing-fluid-m)">
  <h2 class="text-xl font-semibold text-(--color-texto)">Información del centro</h2>
  <div class="mt-(--spacing-fluid-s) grid grid-cols-1 gap-(--spacing-fluid-s) sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
    {notas.map((nota) => <TarjetaContenido nota={nota} />)}
  </div>
</section>

<script>
  // El chat (isla Preact) despacha este CustomEvent con las fuentes RAG
  // usadas en la última respuesta. La rejilla es contenido estático, así
  // que basta con un listener por DOM en vez de convertirla en isla: solo
  // necesita alternar una clase, no re-renderizar nada.
  type Fuente = { fuente: string; categoria?: string | null };

  window.addEventListener('orquestador:fuentes', (evento) => {
    const fuentes = (evento as CustomEvent<Fuente[]>).detail ?? [];
    const nombres = new Set(fuentes.map((f) => f.fuente));

    document.querySelectorAll<HTMLElement>('[data-fuente]').forEach((tarjeta) => {
      const coincide = nombres.has(tarjeta.dataset.fuente ?? '');
      tarjeta.classList.toggle('destacado', coincide);
    });
  });

  // Lightbox de las tarjetas: cada una trae su propio <dialog> con el
  // contenido completo de la nota. Un único listener delegado abre/cierra
  // cualquiera de ellos, en vez de cablear un handler por tarjeta.
  document.addEventListener('click', (evento) => {
    const objetivo = evento.target as HTMLElement;

    const disparador = objetivo.closest<HTMLElement>('[data-abre-dialogo]');
    if (disparador) {
      const dialogo = document.getElementById(disparador.dataset.abreDialogo ?? '');
      if (dialogo instanceof HTMLDialogElement) dialogo.showModal();
      return;
    }

    const cierre = objetivo.closest<HTMLElement>('[data-cierra-dialogo]');
    if (cierre) {
      cierre.closest('dialog')?.close();
      return;
    }

    // Clic en el propio <dialog> (el backdrop interior, no su contenido) cierra.
    if (objetivo instanceof HTMLDialogElement) {
      objetivo.close();
    }
  });
</script>
