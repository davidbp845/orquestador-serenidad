---
import { negocio } from '../lib/negocio';

const precios = (negocio.servicios ?? []).map((s) => s.precio);
const precioMin = precios.length ? Math.min(...precios) : undefined;
const precioMax = precios.length ? Math.max(...precios) : undefined;
const priceRange =
  precioMin === undefined
    ? undefined
    : precioMin === precioMax
      ? `${precioMin}€`
      : `${precioMin}€–${precioMax}€`;

// Día del business.yaml (horario_apertura, mismas claves que
// horario_semanal por profesional) -> nombre de día que espera
// schema.org/OpeningHoursSpecification.
const DIA_A_INGLES: Record<string, string> = {
  lunes: 'Monday',
  martes: 'Tuesday',
  miercoles: 'Wednesday',
  jueves: 'Thursday',
  viernes: 'Friday',
  sabado: 'Saturday',
  domingo: 'Sunday',
};
const ORDEN_DIAS = ['lunes', 'martes', 'miercoles', 'jueves', 'viernes', 'sabado', 'domingo'];

// Dirección, teléfono, email y horario de apertura vienen de
// business.yaml (direccion/telefono/email/horario_apertura) — antes
// estaban transcritos a mano aquí con los datos de Masajes Serenidad,
// así que cualquier otro negocio publicaba SEO estructurado falso
// (#75). Todos opcionales: un negocio puede no querer exponerlos.
const openingHoursSpecification = ORDEN_DIAS.filter((dia) => negocio.horario_apertura?.[dia]).map(
  (dia) => {
    const [opens, closes] = negocio.horario_apertura![dia];
    return {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: [DIA_A_INGLES[dia]],
      opens,
      closes,
    };
  },
);

const datosEstructurados = {
  '@context': 'https://schema.org',
  '@type': 'HealthAndBeautyBusiness',
  name: negocio.nombre,
  ...(negocio.direccion
    ? {
        address: {
          '@type': 'PostalAddress',
          streetAddress: negocio.direccion.calle,
          addressLocality: negocio.direccion.localidad,
          postalCode: negocio.direccion.codigo_postal,
          addressCountry: negocio.direccion.pais,
        },
      }
    : {}),
  ...(negocio.telefono ? { telephone: negocio.telefono } : {}),
  ...(negocio.email ? { email: negocio.email } : {}),
  ...(priceRange ? { priceRange } : {}),
  ...(openingHoursSpecification.length ? { openingHoursSpecification } : {}),
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(datosEstructurados)} />
