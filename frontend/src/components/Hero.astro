---
import ChatWidget from './chat/ChatWidget';
import TestimoniosCarrusel from './TestimoniosCarrusel';
import { negocio } from '../lib/negocio';

const apiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL ?? 'http://localhost:8000';
const ctaMensaje = negocio.cta_cita?.mensaje ?? 'Quiero reservar una cita';
const testimoniosIntervaloMs = Number(import.meta.env.PUBLIC_TESTIMONIOS_INTERVALO_MS) || 7000;
---

<section
  id="seccion-hero"
  data-api-base-url={apiBaseUrl}
  class="mx-auto max-w-6xl px-(--spacing-fluid-s) py-(--spacing-fluid-l) md:px-(--spacing-fluid-m)"
>
  <div class="text-center">
    <h1 class="text-3xl font-bold text-(--color-texto)">{negocio.hero_titulo ?? negocio.nombre}</h1>
    <p class="mt-(--spacing-fluid-2xs) text-(--color-texto-suave)">
      {negocio.hero_subtitulo}
      {/* Poblado por el script de más abajo con GET /testimonios — vacío
          y oculto por defecto hasta saber si hay reseñas, igual que el
          promobar (issue #78) hace con /promobar (Cabecera.astro). */}
      <span id="valoracion-agregada" hidden class="text-(--color-texto)"></span>
    </p>
  </div>
  <div class="mt-(--spacing-fluid-s) grid grid-cols-1 gap-(--spacing-fluid-s) lg:grid-cols-[7fr_3fr]">
    <ChatWidget apiBaseUrl={apiBaseUrl} ctaMensaje={ctaMensaje} client:load />
    <TestimoniosCarrusel apiBaseUrl={apiBaseUrl} intervaloMs={testimoniosIntervaloMs} client:load />
  </div>
</section>

<script>
  // Valoración media agregada (issue #79): dato ligero calculado en el
  // cliente a partir del mismo GET /testimonios que ya usa
  // TestimoniosCarrusel.tsx, sin endpoint ni cambios de backend nuevos.
  interface Testimonio {
    valoracion: number;
  }

  const seccion = document.querySelector<HTMLElement>('#seccion-hero[data-api-base-url]');
  const apiBaseUrl = seccion?.dataset.apiBaseUrl ?? 'http://localhost:8000';
  const valoracionEl = document.getElementById('valoracion-agregada');

  fetch(`${apiBaseUrl}/testimonios`)
    .then((respuesta) => (respuesta.ok ? respuesta.json() : []))
    .then((testimonios: Testimonio[]) => {
      if (!valoracionEl || !Array.isArray(testimonios) || testimonios.length === 0) return;
      const total = testimonios.length;
      const media = testimonios.reduce((suma, t) => suma + t.valoracion, 0) / total;
      const estrellas = '⭐'.repeat(Math.round(media));
      const textoReseñas = total === 1 ? 'reseña' : 'reseñas';
      valoracionEl.textContent = ` · ${estrellas} ${media.toFixed(1)} (${total} ${textoReseñas})`;
      valoracionEl.hidden = false;
    })
    .catch(() => {
      // Backend inalcanzable: la valoración simplemente no aparece esta
      // carga, sin reintento — mismo criterio que el promobar.
    });
</script>
