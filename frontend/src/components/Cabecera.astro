---
import { negocio } from '../lib/negocio';
---

<header
  class="sticky top-0 z-10 border-b border-(--color-borde) bg-(--color-superficie)/90 backdrop-blur-sm"
>
  <div class="mx-auto flex max-w-3xl items-center px-(--spacing-fluid-s) py-(--spacing-fluid-xs) md:max-w-none md:px-(--spacing-fluid-m)">
    <a href="/" class="text-base font-semibold tracking-tight text-(--color-texto)">
      {negocio.logo_url
        ? <img src={negocio.logo_url} alt={negocio.nombre} class="h-7 w-auto" />
        : negocio.nombre}
    </a>
  </div>
</header>
