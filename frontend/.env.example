PUBLIC_API_BASE_URL=http://localhost:8000

# Milisegundos entre rotaciones automáticas del carrusel de testimonios
# del Hero (issue #61). Por defecto 7000 (7s) si no está definida.
PUBLIC_TESTIMONIOS_INTERVALO_MS=7000

# Opt-in explícito (mismo criterio que ENTORNO_LOCAL en panel_empleados/):
# vacío por defecto, solo se activa con =true. No se infiere de
# import.meta.env.DEV ni de la URL, para evitar que el enlace aparezca
# en un build de producción generado accidentalmente en una máquina de
# desarrollo.
PUBLIC_MOSTRAR_PANEL=
PUBLIC_PANEL_URL=http://localhost:8501

# Opcional: ruta a un business.yaml alternativo, leído en build-time por
# frontend/src/lib/negocio.ts (mismo CONFIG_PATH que ya soportan main.py
# y panel_empleados/streamlit_app.py — ver .env.example en la raíz) —
# apunta al mismo fichero en los tres sitios para que backend, panel y
# frontend muestren el mismo negocio real (#73). Sin ella, sigue
# leyendo config/business.yaml de siempre. No lleva prefijo PUBLIC_
# porque nunca llega al navegador, solo se usa en build-time.
CONFIG_PATH=
