# Copia este fichero a .env y rellena los valores reales.
# .env está en .gitignore — nunca se sube al repo.

# Obligatoria si PROVEEDOR_LLM=anthropic (o si no defines PROVEEDOR_LLM,
# ya que "anthropic" es el valor por defecto): clave de la API de Anthropic
ANTHROPIC_API_KEY=

# Opcional: solo si activas el canal de Telegram (config/business.yaml -> canales.telegram)
TELEGRAM_BOT_TOKEN=

# Opcionales, las cuatro juntas: solo si activas el canal de WhatsApp
# (config/business.yaml -> canales.whatsapp). A diferencia de Telegram,
# WhatsApp funciona por webhook (adapters/in_/whatsapp_webhook.py,
# POST /webhook/whatsapp), así que además hace falta una URL pública
# apuntando a ese endpoint (un túnel tipo ngrok en desarrollo, el
# dominio real en producción) configurada en la app de Meta — ver el
# issue de prueba correspondiente para el paso a paso completo.
#   WHATSAPP_ACCESS_TOKEN    -> token de acceso de la app de Meta
#     (Meta for Developers -> tu app -> WhatsApp -> API Setup), con
#     permiso para enviar mensajes en nombre del número de negocio.
#   WHATSAPP_PHONE_NUMBER_ID -> id del número de teléfono de WhatsApp
#     Business (no el número en sí), del mismo panel.
#   WHATSAPP_VERIFY_TOKEN    -> cadena arbitraria elegida por ti; Meta
#     la reenvía al verificar el webhook (handshake GET) y debe
#     coincidir con la que configures en el panel de Meta.
#   WHATSAPP_APP_SECRET      -> secreto de la app de Meta, usado para
#     verificar la firma (X-Hub-Signature-256) de cada webhook entrante
#     y rechazar peticiones que no vengan realmente de Meta.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Opcional: ruta donde persiste la base vectorial de Chroma (por defecto ./chroma_data)
CHROMA_PATH=./chroma_data

# Opcional: token de solo lectura de https://huggingface.co/settings/tokens.
# Sin él, la descarga del modelo de embeddings (sentence-transformers, usado
# por adapters/out/vector_store.py) funciona igual pero con rate limits más
# bajos y un aviso en el log en cada arranque — no desbloquea ninguna
# funcionalidad nueva, solo hace la descarga más fiable (ver #23).
HF_TOKEN=

# Opcional: qué ProveedorLLM usar (ver main.py::construir_sistema()).
#   anthropic (por defecto) -> ProveedorLLMAnthropic, requiere ANTHROPIC_API_KEY
#   mock                    -> ProveedorLLMMock, heurístico, sin red ni credenciales
#   cohere                  -> ProveedorLLMCohere, requiere COHERE_API_KEY
#   openai                  -> ProveedorLLMOpenAI, requiere OPENAI_API_KEY
PROVEEDOR_LLM=

# Obligatoria si PROVEEDOR_LLM=cohere: clave de la API de Cohere. Una
# trial key gratuita (sin tarjeta) en dashboard.cohere.com es suficiente
# para prototipar (1000 llamadas/mes, 20 req/min) — no válida para producción.
COHERE_API_KEY=

# Obligatoria si PROVEEDOR_LLM=openai: clave de la API de OpenAI.
OPENAI_API_KEY=

# Opcionales, ambas: si se definen las dos, las reservas se sincronizan
# con Google Calendar (adapters/out/calendario_google.py). Si falta
# cualquiera de las dos, el sistema sigue funcionando igual que hoy, sin
# sincronizar nada.
#   GOOGLE_CALENDAR_CREDENTIALS_JSON -> ruta al JSON de una cuenta de
#     servicio de Google Cloud con la Calendar API activada. El
#     calendario debe compartirse manualmente con el email de esa
#     cuenta de servicio (campo "client_email" del JSON).
#   GOOGLE_CALENDAR_ID -> id del calendario del negocio (normalmente
#     algo como xxxx@group.calendar.google.com, en la configuración del
#     calendario en Google Calendar).
GOOGLE_CALENDAR_CREDENTIALS_JSON=
GOOGLE_CALENDAR_ID=

# Opcional: zona horaria de los eventos creados en Google Calendar
# (nombre IANA). Por defecto Europe/Madrid si no se define.
GOOGLE_CALENDAR_TIMEZONE=Europe/Madrid

# Opcional: si se define, las sesiones de conversación (historial por
# usuario/canal) se persisten en Redis en vez de en memoria del
# proceso (main.py::construir_repositorio_sesiones()). Sin ella, el
# sistema sigue funcionando igual que hoy: las sesiones no sobreviven
# a un reinicio ni se comparten entre procesos.
REDIS_URL=

# Opcional: contraseña compartida para acceder al panel interno
# (panel_empleados/streamlit_app.py, `streamlit run panel_empleados/streamlit_app.py`).
# Sin ella, el panel se abre sin gate (cómodo para desarrollo local).
PANEL_EMPLEADOS_PASSWORD=

# Opcional: orígenes permitidos por CORS para el chat web
# (adapters/in_/fastapi_app.py), separados por comas, ej.
#   CORS_ORIGINS=https://miapp.com,https://www.miapp.com
# Sin ella, se usan los orígenes de dev habituales (localhost:5173,
# :3000, :4321) — imprescindible definirla al desplegar fuera de
# localhost, o el navegador bloqueará las peticiones del frontend.
CORS_ORIGINS=

# Opcional: si se define, citas/clientes/pedidos se persisten en Postgres
# vía SQLModel (adapters/out/repositorios_postgres.py) en vez de en memoria
# del proceso. Sin ella, el sistema sigue funcionando igual que hoy: cada
# proceso (main.py, panel_empleados/streamlit_app.py) tiene su propio
# almacén en RAM, aislado del otro — una reserva creada por el chat no
# aparece en el panel. Tras definirla hace falta aplicar el esquema:
#   alembic upgrade head
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_bd
# (con un Postgres gestionado como Neon/Supabase/Railway, añade
# ?sslmode=require si el proveedor lo exige).
DATABASE_URL=