{
  "permissions": {
    "allow": [
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -b *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(git stash *)",
      "Bash(gh issue *)",
      "Bash(gh pr *)",
      "Bash(gh project *)",
      "Bash(gh label *)",
      "Bash(gh run *)",
      "Bash(gh secret list *)",
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(ruff check *)",
      "Bash(ruff format *)",
      "Bash(pip install -r requirements.txt)",
      "Bash(pip install -r requirements-dev.txt)",
      "Bash(alembic upgrade head)",
      "Bash(venv/bin/python *)",
      "Bash(venv/bin/pip *)",
      "Bash(venv/bin/pytest *)",
      "Bash(venv/bin/ruff check *)",
      "Bash(venv/bin/ruff format *)",
      "Bash(grep *)",
      "Bash(which *)",
      "Bash(kill *)",
      "Bash(pkill *)",
      "Bash(ps *)",
      "Bash(curl -s *)",
      "Bash(node -e *)",
      "Bash(git branch *)",
      "Bash(git show *)",
      "Bash(git fetch *)",
      "Bash(git remote *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Edit(**)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr merge *)",
      "Bash(gh issue delete *)",
      "Bash(npm publish *)",
      "Bash(npm version *)",
      "Edit(CLAUDE.md)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd*)",
      "Bash(rm -rf *)",
      "Read(**/.env)",
      "Read(**/secrets/**)",
      "Edit(**/.env)",
      "Edit(.claude/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command // empty' | grep -Eq '^[[:space:]]*cd[[:space:]]+\"?\\$\\(git rev-parse[[:space:]]+--show-toplevel\\)\"?' && printf '%s' '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"Redundante: el cwd ya es la raiz del repo y persiste entre llamadas Bash. Ejecuta el comando directamente, sin el prefijo cd \\\"$(git rev-parse --show-toplevel)\\\".\"}}' || true",
            "statusMessage": "Comprobando prefijo cd redundante..."
          }
        ]
      }
    ]
  }
}
